[Unit]
Description=Aurora: servidor de voz e tela (LiveKit)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/aurora/livekit/livekit-server --config %h/aurora/livekit/livekit.yaml
WorkingDirectory=%h/aurora/livekit
Restart=always
RestartSec=3
NoNewPrivileges=yes

[Install]
WantedBy=default.target

{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Aurora",
  "version": "1.4.1",
  "identifier": "app.aurora.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aurora",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#1b1f2a",
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --lang=pt-BR"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCNDE2NDQxRDg1QjBFNjAKUldSZ0RsdllRV1JCYTNUbnFVSnh3N2trT213WUp3ZkFOL2N6MTVPcHJBSUx1ckNzaUt5ZFBJbGUK",
      "endpoints": [],
      "dangerousInsecureTransportProtocol": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "Aurora — comunidades, chat e voz",
    "copyright": "© 2026 Aurora (nome provisório)",
    "category": "SocialNetworking",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"]
      }
    }
  }
}
